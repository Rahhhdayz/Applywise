# Copy to .env and fill in only what you use. Never commit .env (it is gitignored).
# Secrets are left empty here on purpose: an empty variable disables that integration.

# --- Core ---
JOBAGENT_DATABASE=data/jobagent.sqlite3
# Optional path to a non-default settings file (default: config/settings.yaml)
# JOBAGENT_SETTINGS=config/settings.yaml

# --- AI CLIs (scoring uses the Codex CLI; writing, review and routing use the Claude CLI) ---
JOBAGENT_CODEX_BIN=codex
JOBAGENT_SCORING_MODEL=
JOBAGENT_CLAUDE_BIN=claude
# Cover letters, outreach and follow-ups (empty = the CLI default model)
JOBAGENT_WRITING_MODEL=
JOBAGENT_WRITING_MAX_PACKETS=20
# Optional directory holding a cover-letter style guide SKILL.md (default: ~/.claude/skills/coverLetter)
JOBAGENT_COVER_LETTER_SKILL_PATH=
# Telegram plain-English intent router
JOBAGENT_INTENT_MODEL=haiku

# --- Notion (presentation only; SQLite stays the system of record) ---
NOTION_API_KEY=
NOTION_DATABASE_ID=

# --- Telegram bot (only this chat ID is served) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Application pre-fill (`jobagent apply fill`) ---
# Password for creating/signing in to Workday candidate accounts. Never sent to AI and redacted
# from snapshots. Email verification links and security codes are read from GMAIL_* below.
WORKDAY_PASSWORD=
# Per-step AI review of a filled form (off = no review)
JOBAGENT_FILL_REVIEW=
JOBAGENT_REVIEW_MODEL=haiku
# AI drafts for free-text questions (off = leave them blank); model defaults to JOBAGENT_WRITING_MODEL
JOBAGENT_AI_ANSWERS=
JOBAGENT_ANSWER_MODEL=

# --- Outreach contacts (`jobagent outreach`; drafts only, never sent) ---
# Hunter.io domain search when a job names no poster. Calls per run are capped below.
HUNTER_API_KEY=
JOBAGENT_HUNTER_MAX_PER_RUN=3

# --- PDF export: Word on macOS, LibreOffice (soffice) elsewhere. Override with word|libreoffice ---
JOBAGENT_PDF_CONVERTER=

# --- AI auth on a headless server ---
# Subscription: run `claude setup-token` and paste the token here; for Codex run `codex login --device-auth`.
# Pay-per-token instead: remove CLAUDE_CODE_OAUTH_TOKEN and set ANTHROPIC_API_KEY / OPENAI_API_KEY.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Gmail response tracker (`jobagent inbox`): read-only IMAP with a Google app password ---
# An app password grants full mailbox access; JobAgent only ever reads (EXAMINE + BODY.PEEK).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Model for the rare email the rules cannot classify
JOBAGENT_INBOX_MODEL=haiku
# 1 = the cycle's inbox stage applies status changes itself; default: it only proposes them
JOBAGENT_INBOX_AUTO_APPLY=
